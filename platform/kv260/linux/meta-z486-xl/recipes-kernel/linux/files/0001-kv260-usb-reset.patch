Subject: [PATCH] arm64: dts: KV carrier: drive USB hub reset directly

Preserve the USB hub reset wiring tested with the z486 KV260 kernel.
The gpio-delay indirection prevented reliable hub enumeration in that build.

Upstream-Status: Inappropriate [board-tested local workaround]
---
diff --git a/arch/arm64/boot/dts/xilinx/zynqmp-sck-kv-g-revB.dtso b/arch/arm64/boot/dts/xilinx/zynqmp-sck-kv-g-revB.dtso
--- a/arch/arm64/boot/dts/xilinx/zynqmp-sck-kv-g-revB.dtso
+++ b/arch/arm64/boot/dts/xilinx/zynqmp-sck-kv-g-revB.dtso
@@ -75,12 +75,6 @@ dpcon_in: endpoint {
 		};
 	};
 
-	slg_delay: enable-delay {
-		compatible = "gpio-delay";
-		#gpio-cells = <3>;
-		gpio-controller;
-		gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
-	};
 };
 
 &i2c1 { /* I2C_SCK C23/C24 - MIO from SOM */
@@ -159,7 +153,7 @@ hub_2_0: hub@1 {
 		reg = <1>;
 		peer-hub = <&hub_3_0>;
 		i2c-bus = <&hub>;
-		reset-gpios = <&slg_delay 0 10000 10000>;
+		reset-gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
 	};
 
 	/* 3.0 hub on port 2 */
@@ -168,7 +162,7 @@ hub_3_0: hub@2 {
 		reg = <2>;
 		peer-hub = <&hub_2_0>;
 		i2c-bus = <&hub>;
-		reset-gpios = <&slg_delay 0 10000 10000>;
+		reset-gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
 	};
 };
 
